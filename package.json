{
  "name": "stabbed.wtf",
  "private": true,
  "version": "1.6.3",
  "description": "Personal website, blog, photo gallery, and portfolio built with React 19, Vite 6, Tailwind 4, Cloudflare, and SQLite.",
  "type": "module",
  "homepage": "https://stabbed.wtf/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hnpf/stabbed.wtf.git"
  },
  "bugs": {
    "url": "https://github.com/hnpf/stabbed.wtf/issues"
  },
  "author": "hnpf",
  "license": "GPL-3.0",
  "keywords": [
    "virex",
    "portfolio",
    "blog",
    "photography",
    "react",
    "vite",
    "tailwind",
    "sqlite"
  ],
  "scripts": {
    "dev": "vite --port=6767 --host=0.0.0.0",
    "dev:server": "tsx api/index.ts",
    "dev:all": "pnpm run dev:server & pnpm run dev",
    "generate:rss": "tsx scripts/generate-rss.ts",
    "generate:og-data": "tsx scripts/generate-og-data.ts",
    "build": "pnpm run generate:rss && pnpm run generate:og-data && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-github-calendar": "^5.0.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "wrangler": "^4.95.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "unified": "^11.0.5",
    "vite": "^6.2.0"
  }
}
